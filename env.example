# ─────────────────────────────────────────────────────────────
# K-GoodVibe live — ไฟล์ config (คัดลอกเป็น stream.env แล้วเติม key)
#   cp env.example ~/stream.env && chmod 600 ~/stream.env
#   แล้วแก้ STREAM_KEY= ด้านล่าง (ห้าม commit ไฟล์นี้ขึ้น git)
# ─────────────────────────────────────────────────────────────

# คีย์สตรีมจาก YouTube Studio → สร้าง → ถ่ายทอดสด → สตรีม → คีย์สตรีม
# รูปแบบ xxxx-xxxx-xxxx-xxxx-xxxx  (ใช้คีย์เดียวกันทั้ง primary และ backup)
STREAM_KEY=

# URL สตรีม (primary)
RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# URL ของเซิร์ฟเวอร์สำรอง
# - ใส่ค่านี้ = ส่ง 2 feed พร้อมกัน (YouTube สลับให้ถ้า primary ล่ม) แต่ upload เพิ่มเป็น 2 เท่า
# - ปล่อยว่าง = ส่ง feed เดียว ประหยัด bandwidth
BACKUP_URL=rtmp://b.rtmp.youtube.com/live2?backup=1

# ถ้าพอร์ต 1935 ถูกบล็อก (เน็ตมือถือ/ออฟฟิศ/บาง VPS) ใช้ RTMPS คู่นี้แทน (พอร์ต 443)
# RTMP_URL=rtmps://a.rtmps.youtube.com/live2
# BACKUP_URL=rtmps://b.rtmps.youtube.com/live2?backup=1

# ── วิดีโอ ──
# ไฟล์ที่ encode ด้วย make_loop_file.sh แล้ว
VIDEO=/home/ubuntu/stream/loop_1080p.mp4

# 1 = สตรีมด้วย -c:v copy (CPU ~0, ต้อง pre-encode) | 0 = encode สด (กิน CPU มาก)
COPY_MODE=1

# ใช้เมื่อ COPY_MODE=0 เท่านั้น: 4500k = 1080p30, 2500k = 720p
V_BITRATE=4500k
A_BITRATE=192k

# ช่วงเวลาเปิดสตรีม (Asia/Bangkok) เช่น 22:00-06:00 ; ว่าง = เปิดตลอด 24 ชม.
WINDOW=

# เขตเวลาที่ใช้คิด WINDOW
TZ_NAME=Asia/Bangkok

# VPS ตั้งเป็นเลขเยอะๆ / GitHub Actions ใช้ 20700 (5 ชม. 45 น.) เพื่อจบก่อนโดนฆ่าที่ 6 ชม.
MAX_SECONDS=999999999

# (ไม่บังคับ) healthchecks.io ping ทุก 5 นาที — ถ้าไม่ ping เข้า = ได้แจ้งเตือน
HEALTHCHECK_URL=
